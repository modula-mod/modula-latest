# Intended production web routing for Expo Router preview builds.
# Apply via deployment script to Hestia custom include, not by blindly rewriting generated templates.
location / {
    root /home/andrei/deployments/modula-web/current;
    try_files $uri $uri.html $uri/index.html /index.html;
}

location /_expo/ {
    root /home/andrei/deployments/modula-web/current;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
}

location /assets/ {
    root /home/andrei/deployments/modula-web/current;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
}
