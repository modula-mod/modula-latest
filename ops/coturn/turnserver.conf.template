# coturn for Modula 1:1 calls (TURN REST / ephemeral credentials).
#
# Render on the VPS, never commit the rendered file:
#   set -a; . /etc/modula/coturn.env; set +a
#   envsubst '${TURN_REALM} ${TURN_EXTERNAL_IP} ${TURN_STATIC_AUTH_SECRET} ${TURN_CERT} ${TURN_PKEY}' \
#     < ops/coturn/turnserver.conf.template > /etc/modula/turnserver.conf
#   chmod 0600 /etc/modula/turnserver.conf
#
# TURN_STATIC_AUTH_SECRET must equal the API's MODULA_CALLS_TURN_SECRET.

realm=${TURN_REALM}
server-name=${TURN_REALM}

# Ports. 3478 UDP/TCP for TURN, 5349 TCP for TURN over TLS (turns:).
listening-port=3478
tls-listening-port=5349
# Relay allocations. Keep in sync with the firewall rule (49160-49200/udp).
min-port=49160
max-port=49200

# Single public IPv4 on the VPS. Add a second line for IPv6 if wanted.
external-ip=${TURN_EXTERNAL_IP}

# Ephemeral credentials only: username "<expiry>:<pseudonym>",
# password base64(HMAC-SHA1(secret, username)), minted by the API per call.
use-auth-secret
static-auth-secret=${TURN_STATIC_AUTH_SECRET}
fingerprint
# STUN binding stays open (clients use it for srflx candidates).

# TLS for turns:. Reuse the certificate issued for TURN_REALM.
cert=${TURN_CERT}
pkey=${TURN_PKEY}
no-tlsv1
no-tlsv1_1
cipher-list="ECDHE+AESGCM:ECDHE+CHACHA20"

# Abuse limits. A 1:1 call needs at most a few allocations per participant.
user-quota=12
total-quota=1200
max-bps=3000000
stale-nonce=600
max-allocate-lifetime=3600

# Never relay into the host, the docker bridge or private networks (SSRF).
no-loopback-peers
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# No admin surfaces; no TCP relay to arbitrary peers (UDP media only).
no-cli
no-rfc5780
no-stun-backward-compatibility
response-origin-only-with-rfc5780
no-tcp-relay

# Logs to stdout for docker logs; no per-user detail beyond the pseudonym.
log-file=stdout
simple-log
