{
  "name": "@modula/greenfield-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @modula/greenfield-api... build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gai01": "vitest run tests/gai01.contract.test.ts tests/gai01.integration.test.ts",
    "test:gai01:db": "sh -c 'test -n \"$MODULA_TEST_DATABASE_URL\" && vitest run tests/gai01.integration.test.ts'",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:rollback": "tsx scripts/db-rollback.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "api-atlas:identities": "node dist/cli/api-atlas-identities.js",
    "registry:publish-reference-products": "tsx scripts/publish-reference-products.ts",
    "registry:ingest-mps-products": "tsx scripts/ingest-mps-products.ts",
    "registry:publish-mps-products": "tsx scripts/publish-mps-products.ts",
    "registry:sync-github-release": "tsx scripts/sync-github-release.ts",
    "registry:trust-bootstrap": "tsx scripts/trust-bootstrap.ts",
    "registry:migrate-legacy-installs": "tsx scripts/migrate-legacy-installations.ts",
    "registry:trust-cutover-gate": "tsx scripts/trust-cutover-gate.ts"
  },
  "dependencies": {
    "@atproto/oauth-client-node": "^0.3.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@modula/api-contracts": "workspace:*",
    "@modula/atproto-lexicons": "workspace:*",
    "@modula/dimon-contracts": "workspace:*",
    "@modula/greenfield-connector-contracts": "workspace:*",
    "@modula/greenfield-contracts": "workspace:*",
    "@modula/greenfield-module-engine-contracts": "workspace:*",
    "@modula/greenfield-module-manifest": "workspace:*",
    "@modula/greenfield-module-registry-contracts": "workspace:*",
    "@modula/greenfield-module-ui-contracts": "workspace:*",
    "@modula/greenfield-protocol": "workspace:*",
    "@modula/greenfield-product-standard": "workspace:*",
    "@modula/greenfield-runtime": "workspace:*",
    "@modula/greenfield-schema-registry": "workspace:*",
    "@modula/intelligence-contracts": "workspace:*",
    "@modula/intelligence-governance": "workspace:*",
    "@modula/module-backend-protocol": "file:../../../modula-mod/modula-module-standard/packages/module-backend-protocol",
    "@modula/protocol-contracts": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/server": "^13.3.2",
    "fastify": "^5.4.0",
    "jose": "^6.2.8",
    "kysely": "^0.28.2",
    "otplib": "^13.4.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/pg": "^8.15.4",
    "@types/qrcode": "^1.5.6",
    "nid-webauthn-emulator": "^0.2.15",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
