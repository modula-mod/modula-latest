NODE_ENV=development
MODULA_API_HOST=127.0.0.1
MODULA_API_PORT=4020
MODULA_PUBLIC_API_URL=http://127.0.0.1:4020
MODULA_DATABASE_URL=postgresql://modula_api:change-me@127.0.0.1:5433/modula
MODULA_DATABASE_MIGRATOR_URL=postgresql://modula_migrator:change-me@127.0.0.1:5433/modula
MODULA_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8090,https://modula.digital
MODULA_LOG_LEVEL=info
MODULA_TRUST_PROXY=false
MODULA_RATE_LIMIT_ENABLED=true
MODULA_PREVIEW_WRITES_ENABLED=true
MODULA_API_DOCUMENTATION_ENABLED=true
MODULA_MEDIA_ROOT=/var/lib/modula/greenfield-media
MODULA_ENVIRONMENT=development
MODULA_MINIMUM_CLIENT_VERSION=0.1.0
MODULA_SESSION_TTL_HOURS=720
MODULA_ACCESS_TOKEN_TTL_MINUTES=15
MODULA_REFRESH_TOKEN_TTL_DAYS=30
MODULA_EMAIL_VERIFICATION_TTL_HOURS=24
MODULA_INVITE_ONLY=true
# Comma-separated invite codes for preview registration.
# MODULA_REGISTRATION_INVITE_CODES=preview-invite
# Optional session token pepper (recommended in production).
# MODULA_SESSION_PEPPER=
# Optional PKCS#8 Ed25519 private key (base64 DER) for repository checkpoints.
# MODULA_CHECKPOINT_SIGNING_KEY=
# AT Protocol optional bridge — disabled unless explicitly true.
MODULA_ATPROTO_ENABLED=false
MODULA_PDS_PILOT_ENABLED=false
# 32-byte key, base64. Required for preview/production when AT bridge is enabled.
# MODULA_ATPROTO_OAUTH_ENCRYPTION_KEY=
# Comma-separated handles granted admin:* capabilities when minting a preview session. Preview/dev only.
# MODULA_ADMIN_HANDLES=andrei.modula
