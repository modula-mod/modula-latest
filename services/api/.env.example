NODE_ENV=development
MODULA_API_HOST=127.0.0.1
MODULA_API_PORT=4020
MODULA_PUBLIC_API_URL=http://127.0.0.1:4020
MODULA_DATABASE_URL=postgresql://modula_api:change-me@127.0.0.1:5433/modula
MODULA_DATABASE_MIGRATOR_URL=postgresql://modula_migrator:change-me@127.0.0.1:5433/modula
MODULA_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8090,https://modula.digital
MODULA_LOG_LEVEL=info
MODULA_TRUST_PROXY=false
MODULA_RATE_LIMIT_ENABLED=true
MODULA_PREVIEW_WRITES_ENABLED=true
MODULA_API_DOCUMENTATION_ENABLED=true
MODULA_ENVIRONMENT=development
MODULA_MINIMUM_CLIENT_VERSION=0.1.0
MODULA_SESSION_TTL_HOURS=720
MODULA_ATPROTO_ENABLED=true
MODULA_PDS_PILOT_ENABLED=false
# 32-byte key, base64. Required for preview/production.
# MODULA_ATPROTO_OAUTH_ENCRYPTION_KEY=
