NODE_ENV=development
MODULA_ENVIRONMENT=development
MODULA_WORKER_ID=worker-local
MODULA_LOG_LEVEL=info
MODULA_DATABASE_URL=postgresql://modula_worker:change-me@127.0.0.1:5433/modula
MODULA_WORKER_POLL_INTERVAL_MS=1000
MODULA_WORKER_EMPTY_POLL_BACKOFF_MS=5000
MODULA_WORKER_LEASE_DURATION_MS=60000
MODULA_WORKER_LEASE_REAP_INTERVAL_MS=30000
MODULA_WORKER_OUTBOX_DRAIN_INTERVAL_MS=2000
MODULA_WORKER_OUTBOX_BATCH_SIZE=50
MODULA_WORKER_INGEST_INTERVAL_MS=60000
MODULA_WORKER_INGEST_ENABLED=false
# Shared with services/api — same 32-byte base64 key so the worker can decrypt
# atproto_oauth_sessions rows the API encrypted. See services/api/.env.example.
# MODULA_ATPROTO_OAUTH_ENCRYPTION_KEY=
# MODULA_ATPROTO_OAUTH_ENCRYPTION_KEY_PREVIOUS=
MODULA_ATPROTO_SSRF_ALLOW_PRIVATE_NETWORKS=false
