# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.pnpm-store/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
!android/app/debug.keystore
*.p8
*.p12
*.cer
*.key
*.mobileprovision
*.pem

# Signing / cloud credentials (never commit)
credentials.json
**/credentials.json
service-account*.json
*-service-account.json
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# local env files (keep .env.example tracked)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# Native projects are committed after Phase 0 prebuild.
# Local build artefacts under ios/ and android/ remain ignored via
# ios/.gitignore and android/.gitignore (build/, Pods/, .gradle, etc.).
# Do not ignore the ios/ or android/ source trees themselves.

# Phase 5 local release artefacts
.web-release/
services/api/.env
services/api/dist/
packages/*/dist/
ops/docker/.env

.artifacts/
services/greenfield-api/backups/
services/greenfield-api/backups/*.dump
*.dump
*.sql.gz
*.backup

# Phase 7F-A local Mac evidence (logs; not committed)
.local-evidence/

# Evidence export staging (never auto-push)
.staging/

# MCP / agent local secrets (never commit tokens)
.mcp.local.json
.cursor/mcp.local.json
.claude/settings.local.json
**/figma-token*.json

# Playwright MCP local snapshots
.playwright-mcp/
test-results/
