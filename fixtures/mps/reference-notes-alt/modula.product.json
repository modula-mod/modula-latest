    "routes": [
      {
        "path": "/",
        "viewId": "home"
      }
    ],
    "navigation": {
      "rootView": "home"
    }
  },
  "backend": {
    "mode": "greenfield-records",
    "records": [
      {
        "id": "note",
        "schemaVersion": "1.0.0"
      }
    ]
  },
  "data": {
    "resources": [
      {
        "id": "notes",
        "type": "greenfield-records",
        "owner": "GREENFIELD_HOSTED_DATA",
        "schemaVersion": "1.0.0",
        "exportSupported": true,
        "deleteOwner": "greenfield"
      }
