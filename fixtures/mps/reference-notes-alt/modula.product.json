    "uninstall": {
      "keepData": true,
      "deleteData": true,
      "accountDeletion": "delete"
    },
    "export": {
      "supported": true,
      "format": "application/json",
      "owner": "greenfield"
    }
  },
  "capabilities": {
    "provides": [
      "notes.provider"
    ],
    "providerRoles": [
      "notes.provider"
    ]
  },
  "privacy": {
    "dataCreated": [
      "notes"
    ],
    "retention": "account",
    "export": "json",
    "deletion": "supported"
  }
