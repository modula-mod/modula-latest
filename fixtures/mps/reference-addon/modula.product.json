    "status": "development",
    "visibility": "private",
    "testFixture": true
  },
  "publisher": {
    "id": "modula",
    "displayName": "Modula",
    "website": "https://modula.digital",
    "supportUrl": "https://modula.digital/support"
  },
  "source": {
    "repository": "modula-mod/modula-product-standard",
