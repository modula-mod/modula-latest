    "manifestPath": "examples/reference-addon/modula.product.json",
    "provider": "github"
  },
  "licence": {
    "spdx": "MIT",
    "evidence": [
      "LICENSE"
    ],
    "declaredByPublisher": true
  },
  "release": {
