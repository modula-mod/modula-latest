  "network": {
    "class": "approved-external-provider",
    "destinations": [
      {
        "class": "approved-provider",
        "hostPattern": "api.example-notes.test",
        "purpose": "OAuth token exchange"
      }
    ]
  },
  "relationships": [
    {
      "type": "targets",
      "productId": "digital.modula.reference-notes",
      "versionRange": "^0.1.0"
    }
  ],
  "frontend": {
    "mode": "host-contribution",
    "artifact": {
      "path": "frontend/frontend.manifest.json",
      "mediaType": "application/vnd.modula.frontend+json",
      "sha256": "4d8bd6b3f5176fc4191cd2c35287033b69fdd40f8599552b22f43943b42e311a",
      "schemaVersion": "1.0.0"
    }
  },
  "backend": {
    "mode": "none"
  },
  "connectors": {
    "providerId": "example.external.notes",
    "authMethod": "oauth2",
    "oauth": {
      "authorizationUrlDeclared": true,
      "tokenUrlDeclared": true,
      "scopes": [
        "notes.read"
      ]
    },
    "syncDirection": "pull",
    "resources": [
      "notes"
    ],
    "webhooks": false,
    "revocation": "required"
  },
  "secrets": [
    {
      "id": "provider.external.oauth",
      "scope": "connector",
      "purpose": "OAuth client authentication via secret broker"
    }
  ],
  "privacy": {
    "dataAccessed": [
      "external notes metadata"
    ],
    "dataTransmitted": [
      "oauth tokens via secret broker"
    ],
    "externalProcessors": [
      "example.external.notes"
    ],
    "retention": "until disconnection",
    "export": "not-applicable",
    "deletion": "revoke and delete connector state"
  },
  "contributions": [
    {
      "id": "digital.modula.reference-connector.connect",
      "target": "digital.modula.reference-notes/note.action@1",
      "label": "Connect provider"
    }
  ]
