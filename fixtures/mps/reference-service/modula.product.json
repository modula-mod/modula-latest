  "network": {
    "class": "service-fabric-only"
  },
  "frontend": {
    "mode": "none"
  },
  "backend": {
    "mode": "service",
    "service": {
      "id": "digital.modula.reference-service.api",
      "protocolVersion": "1.0.0",
      "type": "https+json",
      "health": {
        "path": "/health",
        "timeoutMs": 2000
      },
      "timeouts": {
        "defaultMs": 5000,
        "maxMs": 30000
      },
      "idempotency": "required",
      "providedCapabilities": [
        "search.query"
      ],
      "consumedCapabilities": [],
      "assertions": {
        "audience": "modula-service:digital.modula.reference-service.api",
        "version": "greenfield.service-assertion.v1"
      }
    }
  },
  "services": [
    {
      "id": "digital.modula.reference-service.api",
      "protocolVersion": "1.0.0",
      "health": {
        "path": "/health"
      }
    }
  ],
  "secrets": [
    {
      "id": "service.signing",
      "scope": "backend",
      "purpose": "Service identity signing material via broker"
    }
  ],
  "engines": {
    "trustClass": "approved-infrastructure-service",
    "capabilities": [
      "search.query"
    ]
  }
