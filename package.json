    "verify:phase7b-branch-consolidation": "node scripts/verify-phase7b-branch-consolidation.mjs",
    "registry:import-module": "node scripts/registry/import-module.mjs",
    "registry:verify-release": "node scripts/registry/verify-release.mjs",
