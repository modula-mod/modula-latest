    "lint": "expo lint",
    "doctor": "expo-doctor",
    "modula": "pnpm --filter @modula/modula-cli exec node dist/cli.js",
    "cli:build": "pnpm --filter @modula/modula-cli build",
    "mcp:greenfield": "pnpm --filter @modula/greenfield-mcp start",
