{
  "name": "@modula/atproto-lexicons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lexicons/*": "./lexicons/*"
  },
  "files": [
    "dist",
    "lexicons"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
