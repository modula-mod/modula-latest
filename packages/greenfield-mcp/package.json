{
  "name": "@modula/greenfield-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "modula-greenfield-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/stdio.js",
    "dev": "tsc -p tsconfig.json && node dist/stdio.js"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
