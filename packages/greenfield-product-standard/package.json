{
  "name": "@modula/greenfield-product-standard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec dist/tests/*.test.js",
    "test:src": "node --import tsx --test --test-reporter=spec src/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "typescript": "~5.9.2"
  }
}
